# ==============================================================================
# ORCA Environment Configuration (.env.example)
# Copy this file to .env and configure your local credentials.
# Do NOT commit .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg://orca_user:orca_password@localhost:5432/orca_db
POSTGRES_USER=orca_user
POSTGRES_PASSWORD=orca_password
POSTGRES_DB=orca_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AI LLM Providers (Priority: 1. Groq, 2. Gemini, 3. OpenRouter)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# External Data Source APIs (Free/Public endpoints default; keys if optional/rate-limit bypass)
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine
GDACS_BASE_URL=https://www.gdacs.org/datareport/resources
NOAA_IBTRACS_BASE_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r00/access/csv

# Frontend Settings (Used in frontend Vite environment)
VITE_API_BASE_URL=http://localhost:8000/api/v1
